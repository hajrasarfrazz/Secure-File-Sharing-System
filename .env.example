# Copy to .env and fill in. NEVER commit .env
SECRET_UPLOAD_TOKEN=change-me-to-a-long-random-string
S3_BUCKET=internee-secure-files
S3_REGION=us-east-1
# For MinIO (local). Remove S3_ENDPOINT for real AWS S3.
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Set to AES256 on real AWS to also enforce server-side encryption at rest
S3_SSE=
MAX_FILE_MB=100
PRESIGN_SECONDS=300
DB_PATH=files.db
